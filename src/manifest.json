{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "Don't Trust Me",
  "description": "Treats sites without a script-governing Content-Security-Policy as Not Secure, the way browsers treat broken certificates.",
  "version": "0.1.0",
  "chromium:minimum_chrome_version": "128",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Don't Trust Me",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "chromium:permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webNavigation",
    "declarativeNetRequestWithHostAccess"
  ],
  "firefox:permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "chromium:service_worker": "background/index.ts",
    "firefox:scripts": ["background/index.ts"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/index.ts"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/interstitial.html"],
      "matches": ["<all_urls>"],
      "chromium:use_dynamic_url": true
    }
  ],
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "dont-trust-me@localhost.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
